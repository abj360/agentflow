# ---------------------------------------------------------------------------
# API settings. These are read by apps/api/config.py, which uses the
# AGENTFLOW_ prefix -- the unprefixed names below are for the containers only.
# ---------------------------------------------------------------------------
AGENTFLOW_DATABASE_URL=postgresql+asyncpg://agentflow:change-me@postgres:5432/agentflow
AGENTFLOW_REDIS_URL=redis://redis:6379/0

# Rate limiting
AGENTFLOW_RATE_LIMIT_REQUESTS=120
AGENTFLOW_RATE_LIMIT_WINDOW_SECONDS=60

# OpenTelemetry. Leave the endpoint empty to disable tracing export entirely;
# set it only when a collector is actually reachable.
AGENTFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=
AGENTFLOW_OTEL_SERVICE_NAME=agentflow-api

# ---------------------------------------------------------------------------
# Model provider. Optional: the console can set a key at runtime from the model
# picker, which is held in the API process only and never written to disk. Set
# one here instead when a deployment should come up already able to reason.
# Whichever is set first wins; pick the model itself from the console.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Postgres container settings. Keep the credentials here in sync with
# AGENTFLOW_DATABASE_URL above -- they configure the server, not the client.
# ---------------------------------------------------------------------------
POSTGRES_DB=agentflow
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Console (Next.js). NEXT_PUBLIC_ vars are inlined into the browser bundle.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ---------------------------------------------------------------------------
# MCP OAuth client credentials for outbound MCP servers.
# ---------------------------------------------------------------------------
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
