{
  "name": "agentflow-console",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format:check": "prettier --check app components e2e hooks lib tests",
    "format:write": "prettier --write app components e2e hooks lib tests",
    "lint": "next lint --dir app --dir components --dir hooks --dir lib --dir tests",
    "start": "next start",
    "test": "playwright test",
    "test:e2e": "playwright test --project e2e",
    "test:unit": "playwright test --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-force": "3.0.0",
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reactflow": "11.11.4"
  },
  "devDependencies": {
    "@playwright/test": "1.44.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "20.12.12",
    "@types/react": "18.3.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.3",
    "prettier": "3.2.5",
    "typescript": "5.4.5"
  }
}
