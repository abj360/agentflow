{
  "title": "agentflow — Budget & Policy",
  "uid": "agentflow-budget",
  "tags": ["agentflow", "budget", "policy"],
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Tokens consumed per session (5m rate)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(agentflow_tokens_total[5m])" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0, "min": 0 }
    },
    {
      "id": 2,
      "title": "Circuit breaker state",
      "type": "stat",
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": 0 },
        { "color": "red", "value": 1 }
      ] } } },
      "targets": [
        { "expr": "agentflow_budget_breaker_open" }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Policy denials per hour (by rule)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(agentflow_policy_denials_total[1h])" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    }
  ]
}
